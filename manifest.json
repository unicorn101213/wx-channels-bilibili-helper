{
    "manifest_version": 3,
    "name": "视频号 · B站下载助手（免激活稳定版）",
    "version": "1.3.0",
    "description": "支持微信视频号（优先本机 4.1.13 服务解析 + ISAAC-64 解密）、B站与抖音（0 弹窗直链提取）",
    "author": "Learning Edition",
    "permissions": [
        "tabs",
        "storage",
        "scripting",
        "downloads"
    ],
    "host_permissions": ["<all_urls>"],
    "action": {
        "default_popup": "./popup/popup.html",
        "default_title": "视频号 · B站下载助手（免激活稳定版）",
        "default_icon": "./imgs/icon64.png"
    },
    "icons": {
        "16": "./imgs/icon16.png",
        "32": "./imgs/icon32.png",
        "48": "./imgs/icon48.png",
        "64": "./imgs/icon64.png",
        "128": "./imgs/icon128.png"
    },
    "background": {
        "service_worker": "./background.js"
    },
    "web_accessible_resources": [
        {
            "resources": ["ajaxhook.min.js", "hook.js"],
            "matches": ["<all_urls>"]
        }
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["./content/decrypt.js", "./content/content.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ]
}
